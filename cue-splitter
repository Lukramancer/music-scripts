#!/usr/bin/env python3

from abc import ABC as AbstractBaseClass
from abc import abstractmethod as abstract_method
from argparse import REMAINDER, ArgumentParser
from collections.abc import Callable, Iterable, Iterator, Sequence
from concurrent.futures import ThreadPoolExecutor
from csv import DictWriter as TableDictWriter
from dataclasses import dataclass
from dataclasses import field as dataclass_field
from enum import Enum
from functools import partial
from itertools import chain, pairwise, starmap
from pathlib import Path
from re import compile as compile_regexp
from subprocess import DEVNULL
from subprocess import run as run_subprocess
from typing import Any, ClassVar, Optional, Self, override

COMMAND_REGEXP = compile_regexp(r"^(?P<indent>\s*)(?P<command_and_arguments>(?P<command>[^\s]+)[^\n]+)$")
TITLE_COMMAND_REGEX = compile_regexp(r"\s*TITLE\s*\"(?P<title>(?:[^\"]|(?:\\\"))+)\"")
PERFORMER_COMMAND_REGEX = compile_regexp(r"\s*PERFORMER\s*\"(?P<performer>(?:[^\"]|(?:\\\"))+)\"")
FILE_COMMAND_REGEX = compile_regexp(r"\s*FILE\s*\"(?P<path>(?:[^\"]|(?:\\\"))+)\"\s*(?P<format>\w+)")
TRACK_COMMAND_REGEX = compile_regexp(r"\s*TRACK\s+(?P<number>\d+)\s+AUDIO")
INDEX_COMMAND_REGEX = compile_regexp(r"\s*INDEX\s+(?P<number>\d+)\s+(?P<minute>\d{2,}):(?P<second>\d{2}):(?P<frame>\d{2})")
ISRC_COMMAND_REGEX = compile_regexp(r"\s*ISRC\s+(?P<isrc>[\d\w]+)")
REM_KEY_VALUE_COMMAND_REGEX = compile_regexp(r"\s*REM\s+(?P<key>\w+)\s+(?P<quote>\")?(?P<value>(?(quote)[^\"]*|[^\s\n]+))(?(quote)\")")


class HierarchyParsable(AbstractBaseClass):
    class UnsupportedCommandError (ValueError):
        ...

    @abstract_method
    def get_upper(self) -> Optional[Self]:
        ...

    @abstract_method
    def parse_command(self, command: str) -> Self:
        ...

    @classmethod
    def parse(cls, initial: Self, commands: Iterable[str]) -> Self:
        current: Optional[Self] = initial

        for command in commands:
            while current is not None:
                try:
                    current = current.parse_command(command)
                except cls.UnsupportedCommandError:
                    current = current.get_upper()
                else:
                    break
            else:
                raise cls.UnsupportedCommandError(f"\"{command}\" is not parseable")

        return initial

    @abstract_method
    def get_meta(self, key: str) -> Optional[str]:
        ...

    def get_meta_recursively(self, key: str) -> Optional[str]:
        if (value := self.get_meta(key)) is not None:
            return value
        elif (hierarchy_upper_object := self.get_upper()) is not None:
            return hierarchy_upper_object.get_meta_recursively(key)
        else:
            return None


@dataclass(order=True)
class CuePosition:
    FRAMES_PER_SECOND: ClassVar[int] = 75

    minute: int
    second: int
    frame: int

    def to_time_specifier(self, precision: int = 4) -> str:
        total_seconds_amount = self.minute * 60 + self.second
        return f"{total_seconds_amount}.{int((10 ** precision) * round(self.frame / self.FRAMES_PER_SECOND, precision))}"


@dataclass
class CueTrack(HierarchyParsable):
    file: Any = dataclass_field() #: CueFile
    number: int
    title: Optional[str] = None
    performer: Optional[str] = None
    indexes: dict[int, CuePosition] = dataclass_field(default_factory=dict)
    isrc: Optional[str] = None
    rems_meta: dict[str, str] = dataclass_field(default_factory=dict)

    IGNORED_COMMANDS: ClassVar[list[str]] = ["FLAGS"]

    def get_position(self, index: int) -> CuePosition:
        return self.indexes[index]

    def get_lowest_position(self) -> CuePosition:
        return min(self.indexes.values())

    def get_start_position(self) -> CuePosition:
        return self.get_position(index=1)

    def get_performer(self) -> Optional[str]:
        if self.performer is not None:
            return self.performer

        return self.file.cd.performer

    @override
    def get_upper(self) -> HierarchyParsable:
        return self.file

    @override
    def parse_command(self, command: str) -> Self:
        if (title_command_match := TITLE_COMMAND_REGEX.fullmatch(command)) is not None:
            self.title = title_command_match.group("title")
        elif (performer_command_match := PERFORMER_COMMAND_REGEX.fullmatch(command)) is not None:
            self.performer = performer_command_match.group("performer")
        elif (isrc_command_match := ISRC_COMMAND_REGEX.fullmatch(command)) is not None:
            self.isrc = isrc_command_match.group("isrc")
        elif (index_command_match := INDEX_COMMAND_REGEX.fullmatch(command)) is not None:
            index_position = CuePosition(**{key: int(index_command_match.group(key)) for key in ["minute", "second", "frame"]})
            self.indexes[int(index_command_match.group("number"))] = index_position
        elif (rem_key_value_match := REM_KEY_VALUE_COMMAND_REGEX.fullmatch(command)) is not None:
            self.rems_meta[rem_key_value_match.group("key")] = rem_key_value_match.group("value")
            return self
        elif any(command.lstrip().startswith(command_name) for command_name in self.IGNORED_COMMANDS):
            return self
        else:
            raise HierarchyParsable.UnsupportedCommandError()

        return self

    @override
    def get_meta(self, key: str) -> Optional[str]:
        if key == "title":
            return self.title
        elif key == "performer":
            return self.performer
        elif key == "number":
            return str(self.number)
        elif key == "isrc":
            return self.isrc
        else:
            return self.rems_meta.get(key)

    def get_tag(self, tag: str) -> Optional[str]:
        if tag.lower() in {"album", "albumtitle", "album_title"}:
            return self.file.get_meta_recursively("title")
        if tag.lower() in {"album_artist", "albumartist"}:
            return self.file.get_meta_recursively("performer")
        else:
            return self.get_meta_recursively(tag)


@dataclass
class CueFile(HierarchyParsable):
    sheet: Any = dataclass_field() #: CueSheet
    path: Path
    format: str
    tracks: list[CueTrack] = dataclass_field(default_factory=list)
    rems_meta: dict[str, str] = dataclass_field(default_factory=dict)

    @override
    def get_upper(self) -> HierarchyParsable:
        return self.sheet

    @override
    def parse_command(self, command: str) -> HierarchyParsable:
        if (track_command_match := TRACK_COMMAND_REGEX.fullmatch(command)) is not None:
            self.tracks.append(CueTrack(
                file=self,
                number=int(track_command_match.group("number"))
            ))
            return self.tracks[-1]
        elif (rem_key_value_match := REM_KEY_VALUE_COMMAND_REGEX.fullmatch(command)) is not None:
            self.rems_meta[rem_key_value_match.group("key")] = rem_key_value_match.group("value")
            return self
        else:
            raise HierarchyParsable.UnsupportedCommandError()

    def get_tracks(self) -> Iterable[CueTrack]:
        return self.tracks

    @override
    def get_meta(self, key: str) -> Optional[str]:
        return self.rems_meta.get(key)


@dataclass(order=True)
class CueSheet(HierarchyParsable):
    title: Optional[str] = None
    performer: Optional[str] = None
    files: list[CueFile] = dataclass_field(default_factory=list)
    rems_meta: dict[str, str] = dataclass_field(default_factory=dict)

    IGNORED_COMMANDS: ClassVar[list[str]] = ["CATALOG"]

    @override
    def get_upper(self) -> Optional[Self]:
        return None

    @override
    def parse_command(self, command: str) -> HierarchyParsable:
        if (title_command_match := TITLE_COMMAND_REGEX.fullmatch(command)) is not None:
            self.title = title_command_match.group("title")
            return self
        elif (performer_command_match := PERFORMER_COMMAND_REGEX.fullmatch(command)) is not None:
            self.performer = performer_command_match.group("performer")
            return self
        elif (file_command_match := FILE_COMMAND_REGEX.fullmatch(command)) is not None:
            self.files.append(CueFile(
                sheet=self,
                path=Path(file_command_match.group("path")),
                format=file_command_match.group("format")
            ))
            return self.files[-1]
        elif (rem_key_value_match := REM_KEY_VALUE_COMMAND_REGEX.fullmatch(command)) is not None:
            self.rems_meta[rem_key_value_match.group("key")] = rem_key_value_match.group("value")
            return self
        elif any(command.startswith(command_name) for command_name in self.IGNORED_COMMANDS):
            return self
        else:
            raise HierarchyParsable.UnsupportedCommandError()

    @classmethod
    def parse_commands(cls, commands: Iterable[str]) -> Self:
        return super().parse(cls(), commands)

    def get_tracks(self) -> Iterable[CueTrack]:
        for file in self.files:
            yield from file.get_tracks()

    @override
    def get_meta(self, key: str) -> Optional[str]:
        if key == "title":
            return self.title
        elif key == "performer":
            return self.performer
        else:
            return self.rems_meta.get(key)


TAGS: list[tuple[str, str]] = [
    ("performer", "artist"),
    ("album", "album"),
    ("number", "track"),
    ("title", "title"),
    ("isrc", "isrc"),
    ("GENRE", "genres"),
    ("DATE", "date"),
    ("COMMENT", "comment")
]


TimedTrack = tuple[CueTrack, str, Optional[str]]


def get_cue_tracks_with_timings(cue_sheet: CueSheet) -> Iterator[TimedTrack]:
    for track, next_track in pairwise(cue_sheet.get_tracks()):
        yield \
            track, \
            track.get_start_position().to_time_specifier(), \
            next_track.get_lowest_position().to_time_specifier()
        
        last_cue_track = next_track

    yield last_cue_track, \
        last_cue_track.get_start_position().to_time_specifier(), None


class FileParsingException(Exception):
    def __init__(self, errors: list[UnicodeDecodeError | HierarchyParsable.UnsupportedCommandError]):
        super().__init__("Could not parse CUE sheet file, errors occured")
        self.parsing_erros = errors


def parse_cue_sheet_file(cue_sheet_file_path: Path, cue_sheet_file_possible_encodings: Optional[Sequence[str]] = None) -> CueSheet:
    if cue_sheet_file_possible_encodings is None:
        cue_sheet_file_possible_encodings = ["utf8"]

    parsing_errors: list[UnicodeDecodeError | HierarchyParsable.UnsupportedCommandError] = []
    for cue_sheet_file_possible_encoding in cue_sheet_file_possible_encodings:
        try:
            with open(cue_sheet_file_path, mode="rt", encoding=cue_sheet_file_possible_encoding) as cue_sheet_file:
                return CueSheet.parse_commands(map(str.rstrip, cue_sheet_file))
        except (UnicodeDecodeError, HierarchyParsable.UnsupportedCommandError) as error:
            parsing_errors.append(error)
    
    raise FileParsingException(parsing_errors)


def extract_tags(track: CueTrack) -> dict[str, str]:
    formattings: dict[str, Any] = {}
    for tag_key, tag in TAGS:
        if (tag_value := track.get_tag(tag_key)) is not None:
            formattings[tag] = tag_value

    return formattings


ExecutionStrategy = Callable[[Iterator[TimedTrack]], Any]


@dataclass
class FfmpegCommandBaseStrategy(AbstractBaseClass):
    parent_directory_path: Path = Path(".")
    output_file_name_formatting: str = "./{artist}/{album}/{track:02}. {title}{file_suffix}"
    extra_ffmpeg_arguments: Optional[list[str | Path]] = None

    def get_ffmpeg_extraction_arguments(self, track: CueTrack, start: str, end: Optional[str]) -> list[str | Path]:
        ffmpeg_arguments: list[str | Path] = [
            "ffmpeg",
            "-i", self.parent_directory_path / track.file.path,
            "-ss", start
        ]

        if end is not None:
            ffmpeg_arguments.extend(("-to", end))

        formattings = extract_tags(track)
        for tag_name, tag_value in formattings.items():
            ffmpeg_arguments.extend(("-metadata", f"{tag_name}={tag_value}"))
    
        if self.extra_ffmpeg_arguments is not None:
            ffmpeg_arguments.extend(self.extra_ffmpeg_arguments)
    
        output_file_path: Path = Path(self.output_file_name_formatting.format_map(
            formattings | {"file_suffix": track.file.path.suffix}
        ))
        ffmpeg_arguments.append(output_file_path)
    
        return ffmpeg_arguments

    @abstract_method
    def on_ffmpeg_extractions_commands(self, ffmpeg_extractions_commands: Iterator[Sequence[str | Path]]):
        ...
    
    def __call__(self, tracks_with_timings: Iterator[TimedTrack]):
        self.on_ffmpeg_extractions_commands(starmap(self.get_ffmpeg_extraction_arguments, tracks_with_timings))


class FfmpegCommandDryStrategy(FfmpegCommandBaseStrategy):
    @override
    def on_ffmpeg_extractions_commands(self, ffmpeg_extractions_commands: Iterator[Sequence[str | Path]]):
        for ffmpeg_extraction_command in ffmpeg_extractions_commands:
            print(*ffmpeg_extraction_command)


@dataclass
class FfmpegCommandMultithreadStrategy(FfmpegCommandBaseStrategy):
    max_workers_amount: Optional[int] = None
    ffmpeg_exectuable_path: Optional[Path | str] = None

    def _start_ffmpeg_process(self, ffmpeg_extraction_command: Sequence[str | Path]):
        run_subprocess(
            executable=self.ffmpeg_exectuable_path,
            args=ffmpeg_extraction_command,
            stdin=DEVNULL
        )
    
    @override
    def on_ffmpeg_extractions_commands(self, ffmpeg_extractions_commands: Iterator[Sequence[str | Path]]):
        with ThreadPoolExecutor(max_workers=self.max_workers_amount) as executor:
            executor.map(self._start_ffmpeg_process, ffmpeg_extractions_commands)


@dataclass
class TableWriteStrategy:
    file_path: Path | int
    delimiter: str

    def _write_table(self, tags_set: set[str], tracks_with_timings: Iterable[TimedTrack]):
        with open(self.file_path, mode="wt") as table_file:
            columns_names = ["path", "start", "end"]
            columns_names.extend(tags_set)
            
            table_dict_writer = TableDictWriter(table_file, fieldnames=columns_names, delimiter=self.delimiter)
            
            table_dict_writer.writeheader()
            for track, track_start, track_end in tracks_with_timings:
                row = {
                    "path": track.file.path,
                    "start": track_start,
                    "end": track_end
                }
                row |= extract_tags(track)

                table_dict_writer.writerow(row)
                
    def __call__(self, tracks_with_timings: Iterator[TimedTrack]):
        tags_set: set[str] = set[str]()
        gathered_tracks: list[TimedTrack] = []
        for track_info in tracks_with_timings:
            tags = extract_tags(track_info[0])
            tags_set.update(tags.keys())
            gathered_tracks.append(track_info)

        self._write_table(tags_set, gathered_tracks)


def perform(
    cue_sheets_files_paths: list[Path],
    cue_sheets_files_encodings: Optional[list[str]],
    execution_strategy: ExecutionStrategy
):
    parse_cue_sheet = partial(
        parse_cue_sheet_file,
        cue_sheet_file_possible_encodings=cue_sheets_files_encodings
    )
    cue_sheets = map(parse_cue_sheet, cue_sheets_files_paths)

    plans = chain(*map(get_cue_tracks_with_timings, cue_sheets))

    execution_strategy(plans)


def type_with_special_value[T, D](type_factory: Callable[[str], T], default_str: str, default_value: D) -> Callable[[str], T | D]:
    return lambda arg: default_value if arg == default_str else type_factory(arg)


class ExecutionStrategyChoices(Enum):
    DRY = "dry"
    EXTRACT = "extract"
    TABLE = "table"


def create_argument_parser() -> ArgumentParser:
    arguments_parser = ArgumentParser(
        prog="cue-splitter",
        description="Script for extracting tracks by .cue file"
    )

    arguments_parser.add_argument("cue_sheets_files_paths", type=Path, nargs="+", help="Paths to .cue file")
    arguments_parser.add_argument("--cue-sheets-files-encodings", "--cue-encodings", type=str, nargs="+", help="Encoding of .cue file")

    arguments_parser.add_argument("--output-file-path", "-o", type=str, help="Format of path for output files")
    arguments_parser.add_argument("--create-output-files-parent-directories", "-p", action="store_true", default=False, help="Create parent directories for output files")

    arguments_parser.add_argument("--ffmpeg-executable-path", "--ffmpeg", type=Path, default=Path("ffmpeg"), help="Path for ffmpeg executable")

    arguments_parser.add_argument("--ffmpeg-codec-copy", const=["-c", "copy"], action="store_const", dest="extra_ffmpeg_arguments", help="Add \"-c copy\" arguments to ffmpeg run")
    arguments_parser.add_argument("--extra-ffmpeg-arguments", nargs=REMAINDER, default=[], action="extend", type=str, help="Extra arguments passed to ffmpeg during lyrics integration", required=False)

    arguments_parser.add_argument("--max-ffmpeg-workers", "--ffmpeg-workers", "--workers", "--max-workers", "-j",
        type=type_with_special_value(int, "-", None),
        default=1,
        help="Max amount of ffmpeg threads")

    arguments_parser.set_defaults(
        execution_strategy_choice=ExecutionStrategyChoices.EXTRACT
    )
    execution_strategy_choice_arguments_group = arguments_parser.add_mutually_exclusive_group()
    execution_strategy_choice_arguments_group.add_argument("--dry",
        action="store_const", const=ExecutionStrategyChoices.DRY, dest="execution_strategy_choice",
        help="Print ffmpeg commands instead of running"
    )
    execution_strategy_choice_arguments_group.add_argument("--write-table",
        action="store_const", const=ExecutionStrategyChoices.TABLE, dest="execution_strategy_choice",
        help="Generate table of tracks"
    )

    arguments_parser.add_argument("--table-delimeter", type=str, default='\t', help="Delimeter used in output table")

    return arguments_parser


def main(arguments: Iterable[str] | None = None):
    arguments_parser = create_argument_parser()

    parsed_arguments = arguments_parser.parse_args(arguments)

    if parsed_arguments.execution_strategy_choice == ExecutionStrategyChoices.DRY:
        execution_strategy = FfmpegCommandDryStrategy(
            parent_directory_path=parsed_arguments.parent_directory_replacement \
                if parsed_arguments.parent_directory_replacement is not None else Path.cwd(),
            output_file_name_formatting=parsed_arguments.output_file_path \
                if parsed_arguments.output_file_path is not None else "./{artist}/{album}/{track:0>2}. {title}{file_suffix}",
            extra_ffmpeg_arguments=parsed_arguments.extra_ffmpeg_arguments
        )
    elif parsed_arguments.execution_strategy_choice == ExecutionStrategyChoices.EXTRACT:
        execution_strategy = FfmpegCommandMultithreadStrategy(
            parent_directory_path=parsed_arguments.parent_directory_replacement \
                if parsed_arguments.parent_directory_replacement is not None else Path.cwd(),
            output_file_name_formatting=parsed_arguments.output_file_path \
                if parsed_arguments.output_file_path is not None else "./{artist}/{album}/{track:0>2}. {title}{file_suffix}",
            extra_ffmpeg_arguments=parsed_arguments.extra_ffmpeg_arguments,
            ffmpeg_exectuable_path=parsed_arguments.ffmpeg_executable_path,
            max_workers_amount=parsed_arguments.max_ffmpeg_workers
        )
    elif parsed_arguments.execution_strategy_choice == ExecutionStrategyChoices.TABLE:
        execution_strategy = TableWriteStrategy(
            file_path=parsed_arguments.output_file_path if parsed_arguments.output_file_path is not None else 1,
            delimiter=parsed_arguments.table_delimeter if parsed_arguments.table_delimeter is not None else "\t"
        )
    else:
        raise ValueError("Could not determine execution strategy (dry/extract/table), check provided arguments")
    

    perform(
        cue_sheets_files_paths=parsed_arguments.cue_sheets_files_paths,
        cue_sheets_files_encodings=parsed_arguments.cue_sheets_files_encodings,
        execution_strategy=execution_strategy
    )


if __name__ == "__main__":
    from sys import argv

    main(argv[1:])
