Tags = dict[str, str]


class Track(AbstractBaseClass):
    @abstract_method
    def get_ffmpeg_extraction_arguments(self) -> list[str | Path]:
        ...

    @abstract_method
    def get_initial_info(self) -> tuple[Tags, float, Path]:
        ...


@dataclass
class FileTrack(Track):
    file_path: Path
    ffprobe_path: Path

    @classmethod
    def from_path(cls, file_track_path: Path, ffprobe_path: Path):
        return cls(file_track_path, ffprobe_path)

    @override
    def get_ffmpeg_extraction_arguments(self) -> list[str | Path]:
        return ["-i", self.file_path]

    @override
    def get_initial_info(self) -> tuple[Tags, float, Path]:
        ffprobe_arguments: list[str | Path] = ["ffprobe", "-loglevel", "quiet", "-show_format", "-of", "json"]
        ffprobe_arguments.extend(self.get_ffmpeg_extraction_arguments())

        ffprobe_run = run_subprocess(
            executable=self.ffprobe_path,
            args=ffprobe_arguments,
            capture_output=True,
            text=True
        )

        file_info = deserialize_json_from_str(ffprobe_run.stdout)["format"]

        return file_info["tags"], float(file_info["duration"]), Path(file_info["filename"])


@dataclass
class FfmpegTimestamp:
    milliseconds: int

    @classmethod
    def from_string(cls, string: str) -> Self:
        if string.__contains__("."):
            components, milliseconds_str = string.split(".", maxsplit=1)
            
            milliseconds = int(milliseconds_str.ljust(3, "0")[:3])
        else:
            components = string
            milliseconds = 0

        current_component_milliseconds_amount = 1000
        for component_str in reversed(components.split(":")):
            milliseconds += int(component_str) * current_component_milliseconds_amount
            current_component_milliseconds_amount *= 60

        return cls(milliseconds)

    def __str__(self) -> str:
        seconds = abs(self.milliseconds) // 1000
        milliseconds = abs(self.milliseconds) % 1000
        
        return f"{'-' if self.milliseconds < 0 else ''}{seconds}.{milliseconds:03d}"

    def __float__(self) -> float:
        return float(self.milliseconds / 1000)

    def __sub__(self, other: Self) -> Self:
        return type(self)(self.milliseconds - other.milliseconds)


@dataclass
class FileSliceTrack(Track):
    ffprobe_path: Optional[str | Path]
    
    file_path: Path
    start: Optional[FfmpegTimestamp]
    end: Optional[FfmpegTimestamp]
    tags: Tags

    @override
    def get_ffmpeg_extraction_arguments(self) -> list[str | Path]:
        extraction_arguments: list[str | Path] = ["-i", self.file_path]

        if self.start is not None:
            extraction_arguments.extend(("-ss", str(self.start)))

        if self.end is not None:
            extraction_arguments.extend(("-to", str(self.end)))
        
        return extraction_arguments

    def get_whole_file_duration_in_seconds(self) -> float:
        ffprobe_arguments: list[str | Path] = [
            "ffprobe",
            "-loglevel", "quiet",
            "-show_format", "-of", "json",
            "-i", self.file_path
        ]

        ffprobe_run = run_subprocess(
            executable=self.ffprobe_path,
            args=ffprobe_arguments,
            capture_output=True,
            text=True
        )

        file_info = deserialize_json_from_str(ffprobe_run.stdout)["format"]
        return float(file_info["duration"])

    def get_duration_in_seconds(self) -> float:
        if self.start is not None and self.end is not None:
            return float(self.end - self.start)
        elif self.start is None and self.end is not None:
            return float(self.end)
        elif self.start is not None and self.end is None:
            return self.get_whole_file_duration_in_seconds() - float(self.start)
        else:
            return self.get_whole_file_duration_in_seconds()

    @override
    def get_initial_info(self) -> tuple[Tags, float, Path]:
        return self.tags, self.get_duration_in_seconds(), self.file_path


# NOTE: too niche feature to be in standard library
# https://github.com/python/cpython/issues/87326#issuecomment-2380079188
class ExtendConstAction(Action):
    def __init__(self, option_strings, dest, const, default=None, required=False, help=None, metavar=None):
        super().__init__(option_strings=option_strings, dest=dest, nargs=0, const=const, default=default, required=required, help=help, metavar=metavar)

    def __call__(self, parser, namespace, values, option_string=None):
        items = getattr(namespace, self.dest, None)

        if items is None:
            items = []
        elif type(items) is list:
            items = items[:]
        else:
            import copy
            items = copy.copy(items)

        items.extend(self.const)

        setattr(namespace, self.dest, items)


class AppendMultiValueTypeActionFactory[T, *FactoryArgumentsPack]:
    @classmethod
    def create(cls, base_name: str, types: tuple[Callable[[str], Any], ...], factory: Callable[[*FactoryArgumentsPack], T]) -> type[Action]:
        return type(base_name + "ParseAction", (Action, ), {
            "__init__": cls.__init,
            "__call__": cls.__parse,
            "TYPES": types,
            "FACTORY": factory
        })

    @classmethod
    def create_from_class(cls, class_cls, types: tuple[Callable[[str], Any], ...]) -> type[Action]:
        return cls.create(class_cls.__name__, types, class_cls)

    @staticmethod
    def __init(pseudo_self, option_strings, dest, nargs=None, const=None, default=None, required=False, help=None, metavar=None):
        if nargs is not None:
            raise ValueError("nargs should not be specified")

        Action.__init__(pseudo_self, option_strings=option_strings, dest=dest, nargs=len(pseudo_self.TYPES), const=const, default=default, required=required, help=help, metavar=metavar)

    @staticmethod
    def __parse(pseudo_self, parser, namespace, values, option_string=None):
        if values is None:
            values = []
        elif isinstance(values, str):
            values = [values]

        value = pseudo_self.FACTORY(*map(lambda type_function, value: type_function(value), pseudo_self.TYPES, values))

        items = getattr(namespace, pseudo_self.dest, None)

        if items is None:
            items = []
        elif type(items) is list:
            items = items[:]
        else:
            import copy
            items = copy.copy(items)

        items.append(value)
        setattr(namespace, pseudo_self.dest, items)


class TagsProcessor(Protocol):
    def __call__(self, tags: Tags, file_path: Path, duration: float) -> Tags:
        ...


@dataclass
class PathTagsProcessor:
    file_path_format: Pattern

    @classmethod
    def get_parsing_action(cls):
        return AppendMultiValueTypeActionFactory.create_from_class(cls, (compile_regex,))

    def __call__(self, tags: Tags, file_path: Path, duration: float) -> Tags:
        file_path_format_match = self.file_path_format.fullmatch(str(file_path))

        return tags | (file_path_format_match.groupdict() if file_path_format_match is not None else Tags())


class TagWiseTagsProcessor(AbstractBaseClass):
    @abstract_method
    def process_tag(self, tag_name: str, tag_value: str) -> Optional[tuple[str, str]]:
        ...

    def __call__(self, tags: Tags, file_path: Path, duration: float) -> Tags:
        return {new_tag[0]: new_tag[1] for tag_name, tag_value in tags.items() if (new_tag := self.process_tag(tag_name, tag_value)) is not None}


@dataclass
class EraserTagsProcessor(TagWiseTagsProcessor):
    erasable_tag: str

    @classmethod
    def get_parsing_action(cls):
        return AppendMultiValueTypeActionFactory.create_from_class(cls, (str,))

    @override
    def process_tag(self, tag_name: str, tag_value: str) -> Optional[tuple[str, str]]:
        return None if tag_name == self.erasable_tag else (tag_name, tag_value)


@dataclass
class EraserRegexTagsProcessor(TagWiseTagsProcessor):
    erasable_tag_pattern: Pattern

    @classmethod
    def get_parsing_action(cls):
        return AppendMultiValueTypeActionFactory.create_from_class(cls, (compile_regex,))

    @override
    def process_tag(self, tag_name: str, tag_value: str) -> Optional[tuple[str, str]]:
        return None if self.erasable_tag_pattern.fullmatch(tag_name) is not None else (tag_value, tag_value)


@dataclass
class WriterTagsProcessor:
    writable_tag: str
    writable_tag_value: str

    @classmethod
    def get_parsing_action(cls):
        return AppendMultiValueTypeActionFactory.create_from_class(cls, (str, str))


    def __call__(self, tags: Tags, file_path: Path, duration: float) -> Tags:
        return tags | {self.writable_tag: self.writable_tag_value}


@dataclass
class FillerTagsProcessor:
    fillable_tag: str
    fillable_tag_value: str

    @classmethod
    def get_parsing_action(cls):
        return AppendMultiValueTypeActionFactory.create_from_class(cls, (str, str))

    def __call__(self, tags: Tags, file_path: Path, duration: float) -> Tags:
        return ({self.fillable_tag: self.fillable_tag_value} | tags) if self.fillable_tag not in tags else tags


@dataclass
class OverriderTagsProcessor(TagWiseTagsProcessor):
    overridable_tag: str
    overridable_tag_value: str

    @classmethod
    def get_parsing_action(cls):
        return AppendMultiValueTypeActionFactory.create_from_class(cls, (str, str))

    @override
    def process_tag(self, tag_name: str, tag_value: str) -> Optional[tuple[str, str]]:
        return tag_name, (self.overridable_tag_value if tag_name == self.overridable_tag else tag_value)


@dataclass
class RegexOverriderTagsProcessor(TagWiseTagsProcessor):
    overridable_tag_name_regex: Pattern
    overridable_tag_value_regex: Pattern
    tag_value_template: str
    
    @classmethod
    def get_parsing_action(cls):
        return AppendMultiValueTypeActionFactory.create_from_class(cls, (compile_regex, compile_regex, str))

    @override
    def process_tag(self, tag_name: str, tag_value: str) -> tuple[str, str]:
        if self.overridable_tag_name_regex.fullmatch(tag_name) is None:
            return tag_name, tag_value
        
        if (tag_value_match := self.overridable_tag_value_regex.fullmatch(tag_value)) is None:
            return tag_name, tag_value
        
        return tag_name, tag_value_match.expand(self.tag_value_template)



@dataclass
class RegexReplacerTagsProcessor(TagWiseTagsProcessor):
    overridable_tag_name_regex: Pattern
    replaceable_substr_regex: Pattern
    replacement: str
    
    @classmethod
    def get_parsing_action(cls):
        return AppendMultiValueTypeActionFactory.create_from_class(cls, (compile_regex, compile_regex, str))

    @override
    def process_tag(self, tag_name: str, tag_value: str) -> tuple[str, str]:
        if self.overridable_tag_name_regex.fullmatch(tag_name) is None:
            return tag_name, tag_value
        
        return tag_name, self.replaceable_substr_regex.sub(self.replacement, tag_value)


@dataclass
class RenameTagTagsProcessor(TagWiseTagsProcessor):
    renameable_tag: str
    new_tag: str

    @classmethod
    def get_parsing_action(cls):
        return AppendMultiValueTypeActionFactory.create_from_class(cls, (str, str))

    @override
    def process_tag(self, tag_name: str, tag_value: str) -> tuple[str, str]:
        return (self.new_tag if tag_name == self.renameable_tag else tag_name), tag_value


@dataclass
class RenameTagRegexTagsProcessor(TagWiseTagsProcessor):
    renameable_tag_pattern: Pattern
    new_tag_template: str

    @classmethod
    def get_parsing_action(cls):
        return AppendMultiValueTypeActionFactory.create_from_class(cls, (compile_regex, str))

    @override
    def process_tag(self, tag_name: str, tag_value: str) -> tuple[str, str]:
        if (tag_name_rename_match := self.renameable_tag_pattern.fullmatch(tag_name)) is not None:
            return tag_name_rename_match.expand(self.new_tag_template), tag_value
        else:
            return tag_name, tag_value


@dataclass
class ExternalTagsProcessor:
    executable_path: Path
    arguments: Optional[str]

    @classmethod
    def get_parsing_action(cls):
        return AppendMultiValueTypeActionFactory.create_from_class(cls, (Path, str))


    def __call__(self, tags: Tags, file_path: Path, duration: float) -> Tags:
        arguments = [self.executable_path.name]
        if self.arguments is not None:
            arguments.extend(split_shell_arguments(self.arguments))

        external_tags_processor_run = run_subprocess(
            executable=self.executable_path,
            args=arguments,
            text=True,
            input=serialize_json_to_str({"path": str(file_path), "duration": duration, "tags": tags}),
            capture_output=True
        )

        return deserialize_json_from_str(external_tags_processor_run.stdout)


def generate_ffmpeg_command(
    track: Track,
    metadata: Tags,
    output_file_path: Path | str,
    ffmpeg_extra_arguments: Optional[Iterable[str | Path]] = None,
) -> list[str | Path]:
    ffmpeg_arguments: list[str | Path] = ["ffmpeg", "-hide_banner"]
    ffmpeg_arguments.extend(track.get_ffmpeg_extraction_arguments())

    ffmpeg_arguments.extend(("-map_metadata", "-1"))
    for tag_name, tag_value in metadata.items():
        ffmpeg_arguments.extend(("-metadata", f"{tag_name}={tag_value}"))

    if ffmpeg_extra_arguments is not None:
        ffmpeg_arguments.extend(ffmpeg_extra_arguments)

    ffmpeg_arguments.append(output_file_path)

    return ffmpeg_arguments


def generate_output_file_path(
    track_tags: Tags,
    output_file_path_format: str,
    output_file_path_separator_replacement: Optional[str] = None,
) -> Path:
    if output_file_path_separator_replacement is not None:
        output_file_path_tags = {
            tag_name: tag_value.replace(path_separator, output_file_path_separator_replacement)
            for tag_name, tag_value in track_tags.items()
        }
    else:
        output_file_path_tags = track_tags

    return Path(output_file_path_format.format_map(output_file_path_tags))


def plan(
    tracks: Iterable[Track],
    tags_processors: list[TagsProcessor],
    output_file_path_format: str,
    output_file_path_separator_replacement: Optional[str] = None,
    included_tags: Optional[list[str]] = None,
    excluded_tags: Optional[list[str]] = None,
    ffmpeg_extra_arguments: Optional[list[str | Path]] = None
) -> Iterable[tuple[Path, list[str | Path]]]:
    for track in tracks:
        track_tags, track_duration, track_path = track.get_initial_info()
        for tags_processor in tags_processors:
            track_tags = tags_processor(track_tags, track_path, track_duration)

        output_file_path = generate_output_file_path(
            track_tags,
            output_file_path_format,
            output_file_path_separator_replacement
        )

        tags_filter: Callable[[str], bool] = lambda tag_name: True
        if included_tags is not None and included_tags.__len__() > 0:
            tags_filter = lambda tag_name: tag_name in included_tags
        elif excluded_tags is not None and excluded_tags.__len__() > 0:
            tags_filter = lambda tag_name: tag_name not in excluded_tags

        track_tags_to_inject: Tags = {tag_name: tag_value for tag_name, tag_value in track_tags.items() if tags_filter(tag_name)}

        yield output_file_path, generate_ffmpeg_command(
            track=track,
            metadata=track_tags_to_inject,
            output_file_path=output_file_path,
            ffmpeg_extra_arguments=ffmpeg_extra_arguments
        )


def process(
    tracks: Iterable[Track],
    tags_processors: list[TagsProcessor],
    output_file_path_format: str,
    output_file_path_separator_replacement: Optional[str] = None,
    create_parent_directories: bool = True,
    included_tags: Optional[list[str]] = None,
    excluded_tags: Optional[list[str]] = None,
    ffmpeg_executable_path: Optional[Path] = None,
    ffmpeg_extra_arguments: Optional[list[str | Path]] = None,
    is_dry_run: bool = False,
    max_ffmpeg_workers_amount: Optional[int] = 1
):
    plans = plan(
        tracks=tracks, tags_processors=tags_processors,
        output_file_path_format=output_file_path_format,
        output_file_path_separator_replacement=output_file_path_separator_replacement,
        included_tags=included_tags, excluded_tags=excluded_tags,
        ffmpeg_extra_arguments=ffmpeg_extra_arguments
    )

    if is_dry_run:
        for _output_file_path, run_arguments in plans:
            print(*run_arguments)

    run = lambda run_arguments: run_subprocess(
        executable=ffmpeg_executable_path,
        args=run_arguments,
        capture_output=False,
        stdin=DEVNULL
    )

    output_directories: set[Path] = set()
    commands = list[Sequence[str | Path]]()
    for a, b in plans:
        output_directories.add(a.parent)
        commands.append(b)

    if create_parent_directories:
        for directory_path in output_directories:
            directory_path.mkdir(exist_ok=True, parents=True)

    with ThreadPoolExecutor(max_workers=max_ffmpeg_workers_amount) as executor:
        executor.map(run, commands)


@dataclass
class TracksTable:
    file_path: Path | int
    delimiter: str

    @classmethod
    def get_file_path(cls, string: str) -> Path | int:
        return 0 if string == "-" else Path(string)

    @classmethod
    def factory(cls, delimiter: str) -> Callable[[str], Self]:
        return lambda file_path: cls(cls.get_file_path(file_path), delimiter)
    

def create_argument_parser(ffmpeg_path: Optional[Path] = None, ffprobe_path: Optional[Path] = None) -> ArgumentParser:
    argument_parser = ArgumentParser()

    input_argument_group = argument_parser.add_argument_group("input")
    input_argument_group.add_argument("file_tracks_paths", type=Path, nargs="*", help="processable files paths")
    input_argument_group.add_argument("--file-slice-tracks-tsv",
        nargs="*", type=TracksTable.factory("\t"), action="extend", dest="file_slice_tracks_tables",
        help="paths to TSV files (or - for stdin) with slices of tracks")
    input_argument_group.add_argument("--file-slice-tracks-csv",
        nargs="*", type=TracksTable.factory(","), action="extend", dest="file_slice_tracks_tables",
        help="paths to CSV files (or - for stdin) with slices of tracks")

    output_argument_group = argument_parser.add_argument_group("output")
    output_argument_group.add_argument(
        "-p", "--create-parent-directories",
        action="store_true",
        help="create parent directories for each file")
    # NOTE: uses python str, so it is possible and useful to align track number like "{track:0>2}"
    output_argument_group.add_argument(
        "-o", "--output",
        type=str, required=True,
        help="format string for output files paths")
    # NOTE: maybe there should be a way to replace so-called reserved characters
    output_argument_group.add_argument(
        "--separator-replacement",
        type=str,
        help="string which replaces path separator in output files paths")
    output_argument_group.add_argument(
        "--dry-run", "--dry",
        action="store_true", dest="is_dry_run",
        help="only print runnable ffmpeg commands")

    tags_processors_argument_group = argument_parser.add_argument_group("tags processing")
    tags_processors_argument_group.set_defaults(tags_processors=list[TagsProcessor]())
    tags_processors_argument_group.add_argument(
        "--infer-from-path",
        action=PathTagsProcessor.get_parsing_action(), dest="tags_processors",
        metavar="<regex>",
        help="matches <regex> to file path and every pair of group name and captured value will be passed to tags set")
    tags_processors_argument_group.add_argument(
        "--erase",
        action=EraserTagsProcessor.get_parsing_action(), dest="tags_processors",
        metavar="<tag_name>",
        help="removes tag with name <tag_name> from tags set")
    tags_processors_argument_group.add_argument(
        "--erase-regex", "--erase-r",
        action=EraserRegexTagsProcessor.get_parsing_action(), dest="tags_processors",
        metavar="<tag_name_regex>",
        help="removes all tags with name matching <tag_name_regex>")
    tags_processors_argument_group.add_argument(
        "--write",
        action=WriterTagsProcessor.get_parsing_action(), dest="tags_processors",
        metavar="<tag_name> <tag_value>",
        help="makes tag with name <tag_name> and value <tag_value> written in resulting file")
    tags_processors_argument_group.add_argument(
        "--override",
        action=OverriderTagsProcessor.get_parsing_action(), dest="tags_processors",
        metavar="<tag_name> <tag_value>",
        help="makes tag with name <tag_name> and value <tag_value> written in resulting file if <tag_name> was in original tags set")
    tags_processors_argument_group.add_argument(
        "--override-regex", "--override-r",
        action=RegexOverriderTagsProcessor.get_parsing_action(), dest="tags_processors",
        metavar="<tag_name_regex> <tag_value_regex> <tag_new_value_template>",
        help="replaces value of tag with name matching <tag_name_regex> and value mathing <tag_value_regex> with <tag_new_value_template> expanded by groups within matched <tag_value_regex>")
    tags_processors_argument_group.add_argument(
        "--replace-tag-value-regex", "--replace-r",
        action=RegexReplacerTagsProcessor.get_parsing_action(), dest="tags_processors",
        metavar="<tag_name_regex> <string_regex> <replacement>",
        help="replaces <string_regex> with <replacement> within values of tags matching <tag_name_regex>")
    tags_processors_argument_group.add_argument(
        "--fill",
        action=FillerTagsProcessor.get_parsing_action(), dest="tags_processors",
        metavar="<tag_name> <tag_value>",
        help="makes tag with name <tag_name> and value <tag_value> written in resulting file if <tag_name> was not in original tags set")
    tags_processors_argument_group.add_argument(
        "--rename",
        action=RenameTagTagsProcessor.get_parsing_action(), dest="tags_processors",
        metavar="<tag_name> <tag_new_name>",
        help="renames from <tag_name> to <tag_new_name>")
    tags_processors_argument_group.add_argument(
        "--rename-regex", "--rename-r",
        action=RenameTagRegexTagsProcessor.get_parsing_action(), dest="tags_processors",
        metavar="<tag_name_regex> <tag_new_name_template>",
        help="renames from <tag_name> to <tag_new_name>")
    tags_processors_argument_group.add_argument(
        "--external", "--external-processor",
        action=ExternalTagsProcessor.get_parsing_action(), dest="tags_processors",
        metavar="<executable_path> <arguments>",
        help="executes <executable_path> with <arguments> providing json of current state of tags to stdin")

    final_tags_argument_group = output_argument_group.add_mutually_exclusive_group()
    final_tags_argument_group.add_argument(
        "--included-tags", type=str, nargs="*", help="list of tags should be written in audio files")
    final_tags_argument_group.add_argument(
        "--excluded-tags", type=str, nargs="*", help="list of tags should NOT be written in audio files")

    ffmpeg_argument_group = argument_parser.add_argument_group("ffmpeg")
    ffmpeg_argument_group.add_argument(
        "--ffmpeg-executable-path", "--ffmpeg",
        type=Path, default=ffmpeg_path,
        help="path to ffmpeg executable")
    ffmpeg_argument_group.add_argument(
        "--ffprobe-executable-path", "--ffprobe",
        type=Path, default=ffprobe_path,
        help="path to ffprobe executable")
    ffmpeg_argument_group.add_argument(
        "--ffmpeg-extra-arguments",
        type=split_shell_arguments,
        help="additional options that will be passed to ffmpeg")
    ffmpeg_argument_group.add_argument(
        "-y",
        action="append_const", const="-y", dest="ffmpeg_extra_arguments",
        help="add \"-y\" option to ffmpeg run")
    ffmpeg_argument_group.add_argument(
        "--ffmpeg-codec-copy",
        action=ExtendConstAction, const=["-codec", "copy"], dest="ffmpeg_extra_arguments",
        help="add \"-codec copy\" options to ffmpeg run")

    argument_parser.add_argument("--max-ffmpeg-workers-amount", "--max-ffmpeg-workers", "--ffmpeg-workers",
        type=lambda arg: None if arg in {"-", "auto"} else int(arg),
        default=1,
        help="max amount of parallel ffmpeg processes"
    )

    return argument_parser


def extract_tracks_from_parsed_arguments(parsed_arguments: Namespace) -> Iterable[Track]:
    tracks = list[Track]()
    
    ffprobe_path: Optional[Path] = parsed_arguments.ffprobe_executable_path

    file_tracks_paths: Optional[list[Path]] = parsed_arguments.file_tracks_paths
    if ffprobe_path is not None and file_tracks_paths is not None and file_tracks_paths.__len__() > 0:
        tracks.extend(FileTrack.from_path(file_track_path, ffprobe_path) for file_track_path in file_tracks_paths)
    elif file_tracks_paths is not None and file_tracks_paths.__len__() > 0:
        raise ValueError("ffprobe was not found")

    file_slice_tracks_tables = parsed_arguments.file_slice_tracks_tables \
        if parsed_arguments.file_slice_tracks_tables is not None else []
    for file_slice_tracks_table in file_slice_tracks_tables:
        with open(file_slice_tracks_table.file_path, mode="rt") as file_slice_tracks_table_file:
            file_slice_tracks_table_dict_reader = TableDictReader(
                file_slice_tracks_table_file,
                delimiter=file_slice_tracks_table.delimiter
            )
            
            for row_number, file_slice_track_info in enumerate(file_slice_tracks_table_dict_reader, start=1):
                if not isinstance(value := file_slice_track_info.get("start"), str) and value is not None:
                    raise TypeError(f"column \"start\" was not specified or has incorrect type at row \"{row_number}\" in file \"{file_slice_tracks_table.file_path}\"")
                start = value if value is not None and len(value) > 0 else None
                
                if not isinstance(value := file_slice_track_info.get("end"), str) and value is not None:
                    raise TypeError(f"column \"end\" was not specified or has incorrect type at row \"{row_number}\" in file \"{file_slice_tracks_table.file_path}\"")
                end = value if value is not None and len(value) > 0 else None

                used_columns_names = ["start", "end"]

                for file_path_column_name in ["file", "path", "file_path"]:
                    if isinstance(file_path_str := file_slice_track_info.get(file_path_column_name), str) and len(file_path_str) > 0:
                        used_columns_names.append(file_path_column_name)
                        break
                else:
                    raise TypeError(f"column \"path\" was not specified or has incorrect type at row \"{row_number}\" in file \"{file_slice_tracks_table.file_path}\"")

                tracks.append(FileSliceTrack(
                    ffprobe_path=ffprobe_path,
                    file_path=Path(file_path_str),
                    start=FfmpegTimestamp.from_string(start) if start is not None else None,
                    end=FfmpegTimestamp.from_string(end) if end is not None else None,
                    tags={
                    column_name: column_value
                        for column_name, column_value in file_slice_track_info.items()
                        if column_name not in used_columns_names and \
                            isinstance(column_name, str) and \
                            isinstance(column_value, str) and len(column_value) > 0
                    }
                ))

    return tracks


def main():
    from shutil import which

    ffmpeg_path_str, ffprobe_path_str = which("ffmpeg"), which("ffprobe")
    ffmpeg_path: Optional[Path] = Path(ffmpeg_path_str) if ffmpeg_path_str is not None else None
    ffprobe_path: Optional[Path] = Path(ffprobe_path_str) if ffprobe_path_str is not None else None

    argument_parser = create_argument_parser(ffmpeg_path, ffprobe_path)
    parsed_arguments = argument_parser.parse_args()

    tracks: list[Track] = list(extract_tracks_from_parsed_arguments(parsed_arguments))

    process(
        tracks=tracks,
        tags_processors=parsed_arguments.tags_processors,
        output_file_path_format=parsed_arguments.output,
        output_file_path_separator_replacement=parsed_arguments.separator_replacement,
        create_parent_directories=parsed_arguments.create_parent_directories,
        included_tags=parsed_arguments.included_tags,
        excluded_tags=parsed_arguments.excluded_tags,
        ffmpeg_executable_path=parsed_arguments.ffmpeg_executable_path,
        ffmpeg_extra_arguments=parsed_arguments.ffmpeg_extra_arguments,
        is_dry_run=parsed_arguments.is_dry_run,
        max_ffmpeg_workers_amount=parsed_arguments.max_ffmpeg_workers_amount
    )


if __name__ == "__main__":
    main()